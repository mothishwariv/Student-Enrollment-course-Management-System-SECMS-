<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Fees_Must_Be_Paid_Before_Approval</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL( Enrollement_Status__c , &quot;Approved&quot;),
NOT(Fees_Paid__c)
)</errorConditionFormula>
    <errorMessage>Fees must be paid before approving an enrollment</errorMessage>
</ValidationRule>
